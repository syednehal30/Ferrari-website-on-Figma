# Windows users: Start ZanDop Workspace.bat + Local setup is the preferred path.
# This file is for advanced cloud/server adapters, not the Windows workspace launcher.
# Local demo is the default. Never commit actual credentials.
ZANDOP_LIVE_MODE=false
ZANDOP_SEED_DEMO=true
ZANDOP_OPERATOR_TOKEN=
ZANDOP_DATA_DIR=data
PORT=8000
CHROMIUM_EXECUTABLE=/usr/bin/chromium

# Provider choices are not yet decided. These defaults are replaceable.
OUTREACH_PROVIDER=instantly
INSTANTLY_API_KEY=
SMARTLEAD_API_KEY=
OUTREACH_CAMPAIGN_ID=
OUTREACH_SENDER=
OUTREACH_DOMAIN=
OUTREACH_WARMED_AT=
AGENCY_PRIMARY_DOMAIN=
PERSONAL_EMAIL_DOMAINS=
MAX_BOUNCE_RATE=0.02
AUTOMATION_WEBHOOK_SECRET=

CALENDAR_PROVIDER=calcom
BOOKING_URL=
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_WEBHOOK_SECRET=
CALENDLY_WEBHOOK_SECRET=

# Separate agency correspondence, never the personal inbox.
RESEND_API_KEY=
CLIENT_EMAIL_FROM=


# Optional live discovery and writing providers.
GOOGLE_PLACES_API_KEY=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Quotes are edited per client in the UI, minimum $500 USD.
# Payoneer requests are created in the owner account; paste links in the client record.

# Public/authorized CSV, JSON, or JSON-LD feeds. Robots directives are respected.
# Format: [{"kind":"shopify_directory","url":"https://approved-source.example/feed.csv","service":"ecommerce"}]
ZANDOP_SOURCES='[]'

PUBLIC_BASE_URL=
AGENCY_WEBSITE=
